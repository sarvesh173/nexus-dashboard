# Copy to your agent's env file, then chmod 600.
# One key, referenced by every linked agent. Never commit the real one.

NEXUS_CLOUD_API_KEY=REPLACE_ME

# Optional. Only these are read from the environment; the refresh cadence and
# the listen port are module constants, not environment variables.
#
#   HERMES_HOME          default ~/.hermes
#   HERMES_CONFIG        default $HERMES_HOME/config.yaml
#   OMNIROUTE_HOME       default ~/.omniroute
#   OMNIROUTE_BASE_URL   default http://127.0.0.1:20128/v1
#   NEXUS_DIR            default the checkout
